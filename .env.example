# Datey - Important Date Reminder
#
# These values are read at startup. Every variable below (except DATA_DIR) can
# additionally be overridden by an administrator via Settings -> Configuration
# in the admin UI; the database value takes precedence over the env value.
# Fields marked (restart required) are persisted but only applied on next boot.
# DATA_DIR is env-only and shown read-only in the admin UI.

## Server
PORT=6270              # (restart required)
DATA_DIR=/db           # env-only, not DB-overridable
DEBUG=0

## Logging
LOG_LEVEL=warn
LOG_BUFFER_SIZE=10000  # (restart required)
OTEL_ENDPOINT=         # (restart required)

## Scheduler
SCHEDULER_HOUR=8       # (restart required)
REMINDER_DAYS=7

## Database Backup
BACKUP_DIR=/db/backups
BACKUP_RETENTION_DAYS=30

## Email (SMTP) Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-password
SMTP_TLS=true
SMTP_TIMEOUT=10
NOTIFICATION_EMAIL=your@email.com

## Gotify Notifications
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=your-gotify-token

## Telegram Notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

## ntfy Notifications
NTFY_URL=https://ntfy.sh                  # Base URL of your ntfy server
NTFY_TOPIC=your-topic                     # Topic to publish reminders to (required to enable ntfy)
NTFY_TOKEN=your-access-token              # Optional bearer token for authenticated servers
NTFY_PRIORITY=3                           # Priority 1-5 (default: 3)

## Webhook Notifications
WEBHOOK_URL=                              # Comma-separated list of URLs to POST JSON reminders to (required to enable webhook)
WEBHOOK_SECRET=your-webhook-secret        # Optional secret to sign requests with (X-Datey-Signature: sha256=<hmac>)

## Analytics (Umami)
UMAMI_URL=https://umami.example.com
UMAMI_WEBSITE_ID=your-website-uuid

## Appearance
EINK_MODE=false

## iCal Feed
ICAL_FEED_ENABLED=false            # Enable the public iCal feed (default: disabled)
ICAL_EVENT_START=                  # Start time for feed events as HH:MM (e.g. 09:00); empty = all-day events
ICAL_EVENT_DURATION=60             # Event duration in minutes (1-1440); used when ICAL_EVENT_START is set
ICAL_FEED_KEY=                     # Secret key required in feed URLs; auto-generated when enabled via the UI

## RSS Feed
RSS_FEED_ENABLED=false             # Enable the public RSS feed of upcoming events (default: disabled)
RSS_FEED_KEY=                      # Secret key required in the feed URL; auto-generated when enabled via the UI

## Upcoming Events API
UPCOMING_API_ENABLED=false         # Enable the public JSON API of upcoming events (default: disabled)
UPCOMING_API_KEY=                  # Secret key required in the API URL; auto-generated when enabled via the UI
