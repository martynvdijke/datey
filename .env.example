# Datey - Important Date Reminder
#
# These values are read at startup. Every variable below (except DATA_DIR) can
# additionally be overridden by an administrator via Settings -> Configuration
# in the admin UI; the database value takes precedence over the env value.
# Fields marked (restart required) are persisted but only applied on next boot.
# DATA_DIR is env-only and shown read-only in the admin UI.

## Server
PORT=6270              # (restart required)
DATA_DIR=/db           # env-only, not DB-overridable
DEBUG=0

## Logging
LOG_LEVEL=warn
LOG_BUFFER_SIZE=10000  # (restart required)

## OpenTelemetry (traces, metrics, logs)
# Any non-empty endpoint enables OTLP export; without one, telemetry is a no-op.
OTEL_ENDPOINT=         # (restart required)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # optional, takes precedence
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc                   # grpc (default) or http/protobuf
# OTEL_SERVICE_NAME=datey
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=0.1                        # ratio when sampler is traceidratio
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

## Scheduler
SCHEDULER_HOUR=8       # (restart required)
REMINDER_DAYS=7
SUBSCRIPTION_POLL_HOURS=24  # hours between live ICS subscription fetches; 0 disables (restart required)

## Display
DATE_VARIANT=european  # date display variant: european ("25 Dec") or us ("Dec 25")
TIMEZONE=  # IANA zone for people without their own, e.g. Europe/Berlin (empty = server local)

## Database Backup
BACKUP_DIR=/db/backups
BACKUP_RETENTION_DAYS=30
WEEKLY_BACKUP_DAY=0
WEEKLY_BACKUP_RETENTION_WEEKS=52

## Public base URL of this instance (used to build password-reset links sent by email)
# APP_URL=https://datey.example.com

## Demo account
# WARNING: the demo account is a normal READ-WRITE user, and its credentials are
# shown publicly on the login page. Enable this only for a disposable demo
# deployment. It defaults to on only when APP_URL's host is datey.vandijke.xyz;
# set explicitly to override. Demo content is seeded only on an empty instance
# (no people in the shared address book). Leave commented to keep the host-based
# default; uncomment and set to false to disable it on the hosted demo instance.
# DEMO_USER_ENABLED=false
DEMO_USER_HANDLE=demo
DEMO_USER_PASSWORD=demo
DEMO_USER_EMAIL=demo@datey.local

## Email (SMTP) Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-password
SMTP_TLS=true
SMTP_TIMEOUT=10
NOTIFICATION_EMAIL=your@email.com

## Gotify Notifications
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=your-gotify-token

## Telegram Notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret   # Authenticates inbound bot updates; set the same value as secret_token in setWebhook

## ntfy Notifications
NTFY_URL=https://ntfy.sh                  # Base URL of your ntfy server
NTFY_TOPIC=your-topic                     # Topic to publish reminders to (required to enable ntfy)
NTFY_TOKEN=your-access-token              # Optional bearer token for authenticated servers
NTFY_PRIORITY=3                           # Priority 1-5 (default: 3)

## Pushover Notifications
PUSHOVER_TOKEN=                           # Application API token (required to enable Pushover)
PUSHOVER_USER=                            # Default recipient user key

## Webhook Notifications
WEBHOOK_URL=                              # Comma-separated list of URLs to POST JSON reminders to (required to enable webhook)
WEBHOOK_SECRET=your-webhook-secret        # Optional secret to sign requests with (X-Datey-Signature: sha256=<hmac>)

## Discord Notifications
DISCORD_WEBHOOK_URL=                      # Discord channel webhook URL (Server Settings -> Integrations -> Webhooks)

## Slack Notifications
SLACK_WEBHOOK_URL=                        # Slack incoming webhook URL (Slack App -> Incoming Webhooks)

## Matrix Notifications
MATRIX_HOMESERVER_URL=https://matrix.example.com   # Matrix homeserver URL
MATRIX_ACCESS_TOKEN=your-matrix-token              # Matrix access token (Element -> Settings -> Help & About)
MATRIX_ROOM_ID=!abc123:example.com                 # Matrix room ID

## Analytics (Umami)
UMAMI_URL=https://umami.example.com
UMAMI_WEBSITE_ID=your-website-uuid

## Legal / privacy
# Published on /privacy, /terms and /account/delete. Empty values fall back to
# neutral wording ("the operator of this Datey instance"); set them before
# submitting the Android app to a store, which needs a reachable policy URL.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=
# Where the server actually runs; appears in the data-transfer paragraph.
LEGAL_HOSTING_REGION=

## Appearance
EINK_MODE=false

## iCal Feed
ICAL_FEED_ENABLED=false            # Enable the public iCal feed (default: disabled)
ICAL_EVENT_START=                  # Start time for feed events as HH:MM (e.g. 09:00); empty = all-day events
ICAL_EVENT_DURATION=60             # Event duration in minutes (1-1440); used when ICAL_EVENT_START is set
ICAL_FEED_KEY=                     # Secret key required in feed URLs; auto-generated when enabled via the UI

## RSS Feed
RSS_FEED_ENABLED=false             # Enable the public RSS feed of upcoming events (default: disabled)
RSS_FEED_KEY=                      # Secret key required in the feed URL; auto-generated when enabled via the UI

## Upcoming Events API
UPCOMING_API_ENABLED=false         # Enable the public JSON API of upcoming events (default: disabled)
UPCOMING_API_KEY=                  # Secret key required in the API URL; auto-generated when enabled via the UI

## Home Assistant
HOMEASSISTANT_ENABLED=false         # Enable the Home Assistant stats feed (default: disabled)
HOMEASSISTANT_KEY=                  # Secret key required in the feed URL; auto-generated when enabled via the UI

## Web Push Notifications
PUSH_ENABLED=false                 # Enable Web Push browser notifications (requires HTTPS or localhost)
PUSH_VAPID_PUBLIC_KEY=             # Public VAPID key; auto-generated on first enable via the UI (optional env override)
PUSH_VAPID_PRIVATE_KEY=            # Private VAPID signing key — secret, never share (optional env override)

## OIDC login via Authelia (see openspec/changes/add-authelia-oidc)
# OIDC_ENABLED=false                # Set true to enable "Login with Authelia"
# OIDC_ISSUER_URL=https://authelia.example.com
# OIDC_CLIENT_ID=datey
# OIDC_CLIENT_SECRET=               # Or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_secret (file wins, never commit)
# OIDC_REDIRECT_URL=https://datey.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile groups
