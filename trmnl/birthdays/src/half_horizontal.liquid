<div class="columns">
  <div class="column">
    {% if IDX_0.next_birthday %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">{{ IDX_0.next_birthday.name }}{% if IDX_0.next_birthday.age %} ({{ IDX_0.next_birthday.age }}){% endif %}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{{ IDX_0.next_birthday.date }} — {{ IDX_0.next_birthday.relative }}</span>
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">No upcoming birthdays</span>
        </div>
      </div>
    {% endif %}
    <div class="col col--start gap">
      {% for birthday in IDX_0.birthdays limit:3 %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label">{{ birthday.name }} — {{ birthday.date }}{% if birthday.age %} ({{ birthday.age }}){% endif %}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ IDX_0.birthdays.size }} upcoming</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Datey Birthdays — {{ trml.plugin_settings.custom_fields_values.url }}</span>
</div>
