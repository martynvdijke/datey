<div class="grid grid--cols-2 layout--stretch">
  <div class="col col--start gap">
    {% if next_birthday %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">{{ next_birthday.name }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ next_birthday.date }} ({% if next_birthday.relative %}{{ next_birthday.relative }}{% else %}in {{ next_birthday.days_remaining }} days{% endif %}){% if next_birthday.age %} — {{ next_birthday.age }}{% endif %}</span>
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">No upcoming birthdays</span>
        </div>
      </div>
    {% endif %}
  </div>
  <div class="col col--start gap">
    {% for birthday in birthdays %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ birthday.name }} — {{ birthday.date }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Datey Birthdays — {{ trml.plugin_settings.custom_fields_values.url }}</span>
</div>
