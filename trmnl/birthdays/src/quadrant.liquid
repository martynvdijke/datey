<div class="grid grid--cols-2">
  <div class="col col--start gap">
    {% if IDX_0.next_birthday %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">{{ IDX_0.next_birthday.name }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ IDX_0.next_birthday.date }} ({{ IDX_0.next_birthday.relative }}){% if IDX_0.next_birthday.age %} — {{ IDX_0.next_birthday.age }}{% endif %}</span>
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">No upcoming birthdays</span>
        </div>
      </div>
    {% endif %}
  </div>
  <div class="col col--start gap">
    {% for birthday in IDX_0.birthdays %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ birthday.name }} — {{ birthday.date }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Datey Birthdays — {{ trml.plugin_settings.custom_fields_values.url }}</span>
</div>
