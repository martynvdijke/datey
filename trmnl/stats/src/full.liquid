<div class="layout layout--col gap">
  <div class="grid grid--cols-1">
    {% if IDX_0.next_event %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large">{{ IDX_0.next_event.name }} - {{ IDX_0.next_event.date }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">{{ IDX_0.next_event.relative }}</span>
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">No upcoming dates</span>
        </div>
      </div>
    {% endif %}
  </div>
  <div class="hr"></div>
  <div class="grid grid--cols-2">
    <div class="col col--start gap">
      {% for event in IDX_0.upcoming %}
        <div class="item">
          <div class="meta">{{ event.type }}</div>
          <div class="content">
            <span class="label">{{ event.name }} - {{ event.date }} ({{ event.relative }})</span>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="col col--start gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ IDX_0.stats.people_count }} people tracked</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ IDX_0.stats.events_next_7_days }} events in 7 days</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ IDX_0.stats.events_next_30_days }} events in 30 days</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">{{ IDX_0.stats.configured_channels }} channels configured</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Datey — important dates at a glance ({{ trml.plugin_settings.custom_fields_values.url }})</span>
</div>
