<div class="columns layout--stretch">
  <div class="column">
    {% if next_event %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">{{ next_event.name }} - {{ next_event.date }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small">{% if next_event.relative %}{{ next_event.relative }}{% else %}In {{ next_event.days_remaining }} days{% endif %}</span>
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium">No upcoming dates</span>
        </div>
      </div>
    {% endif %}
    <div class="col col--start gap">
      {% for event in upcoming limit:3 %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label">{{ event.name }} - {{ event.date }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="column">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ stats.people_count }} people</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ stats.events_next_7_days }} events/7d</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ stats.events_next_30_days }} events/30d</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Datey — {{ trml.plugin_settings.custom_fields_values.url }}</span>
</div>
